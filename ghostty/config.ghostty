# theme
theme = light:custom-one-light, dark:custom-one-dark
#theme = light:custom-fleet-light, dark:custom-fleet-dark
palette-generate = true
palette-harmonious = true

# keybindings
# --- unbinds ---
keybind = cmd+opt+arrow_left=unbind
keybind = cmd+opt+arrow_down=unbind
keybind = cmd+opt+arrow_up=unbind
keybind = cmd+opt+arrow_right=unbind
keybind = cmd+ctrl+arrow_left=unbind
keybind = cmd+ctrl+arrow_down=unbind
keybind = cmd+ctrl+arrow_up=unbind
keybind = cmd+ctrl+arrow_right=unbind
# --- bindings ---
# vim style pane navigation
keybind = cmd+opt+h=goto_split:left
keybind = cmd+opt+j=goto_split:down
keybind = cmd+opt+k=goto_split:up
keybind = cmd+opt+l=goto_split:right
keybind = cmd+ctrl+h=resize_split:left,10
keybind = cmd+ctrl+j=resize_split:down,10
keybind = cmd+ctrl+k=resize_split:up,10
keybind = cmd+ctrl+l=resize_split:right,10

# font
window-title-font-family = SF Mono Bold
font-family = SF Mono
font-thicken = true
font-thicken-strength = 200
font-feature = -calt, -liga, -dlig

# shell integration
shell-integration-features = ssh-env, ssh-terminfo, no-cursor, sudo, title

# cells
adjust-cell-height = 30%

# cursor
cursor-click-to-move = false
cursor-style = block
cursor-style-blink = false
adjust-cursor-height = 30%

# mouse
mouse-hide-while-typing = true

# window
confirm-close-surface = false
window-theme = system
window-save-state = always
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true

# panes
unfocused-split-opacity = 1

# macOS specific
macos-option-as-alt = true
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = visible
window-colorspace = display-p3

# bell
bell-features = no-title, no-attention

# notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s
